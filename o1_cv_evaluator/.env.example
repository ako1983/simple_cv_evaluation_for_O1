# Copy to .env and fill in the keys you actually want to use.
# At least one provider key is required; Claude is the default.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Optional — override the FastAPI base URL the Streamlit app talks to.
BACKEND_URL=http://localhost:8000

# Optional — change FastAPI log verbosity (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO
